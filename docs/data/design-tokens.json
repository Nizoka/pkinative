  "exception": {
    "palette": "dark",
    "tokens": {
      "--c-primary": { "charter": "#3b82f6", "value": "#60a5fa" },
      "--c-primary-fg": { "charter": "#ffffff, inherited from the light palette", "value": "#0f172a" }
    },
    "reason": "WCAG 2.2 SC 1.4.3 (AA). The charter's dark --c-primary #3b82f6 measures 3.98:1 on --c-bg-alt, and its inherited #ffffff label measures 3.68:1 on #3b82f6. #60a5fa measures 5.75:1 on --c-bg-alt and #0f172a measures 7.02:1 on #60a5fa. The only visible difference is the primary button label."
  },

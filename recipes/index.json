{
  "$comment": "Executable documentation. Each entry names a recipe, the task it demonstrates, the exports it uses, the version it first worked in, and key=value expectations asserted by tests/docs/recipes.test.ts on every run. docs/llms-recipes.txt concatenates the files for agents.",
  "recipes": [
    {
      "file": "quick-start.ts",
      "task": "Read PEM certificates and print subject, issuer, validity, names and fingerprint (the README quick start)",
      "surface": ["decodePem", "parseCertificate", "getExtension", "formatDistinguishedName", "computeFingerprint", "formatFingerprint", "encodePem"],
      "since": "0.1.0",
      "expects": [
        "subject=subject: CN=letsencrypt.org",
        "issuer=issuer:  CN=YE2,O=Let's Encrypt,C=US",
        "valid=valid:   2026-09-04T14:34:32.000Z → 2026-12-03T14:34:31.000Z",
        "firstName=names:   cp.letsencrypt.org",
        "fingerprint=sha-256: 1F:C4:F6:97:EE:FA:30:22:D8:72:DF:23:22:93:BD:DA:76:24:C9:39:64:D7:78:A5:30:26:91:2D:9D:52:9A:53"
      ]
    },
    {
      "file": "agent-brief.ts",
      "task": "Compose decodePem and parseCertificate to read the host names of a certificate (the docs/agent-brief.md sample)",
      "surface": ["decodePem", "parseCertificate", "getExtension", "encodePem"],
      "since": "0.2.0",
      "expects": ["names=cp.letsencrypt.org,cp.root-x1.letsencrypt.org,cps.letsencrypt.org,cps.root-x1.letsencrypt.org,lencr.org,letsencrypt.com,letsencrypt.org,www.lencr.org,www.letsencrypt.com,www.letsencrypt.org"]
    },
    {
      "file": "inspect-extensions.ts",
      "task": "Walk every extension, keep them raw when an inspection tool needs to, and decode one on demand",
      "surface": ["parseCertificate", "getExtension", "decodeExtensionValue", "getOidName"],
      "since": "0.1.0",
      "expects": [
        "extensions=keyUsage!,extendedKeyUsage,basicConstraints!,subjectKeyIdentifier,authorityKeyIdentifier,authorityInfoAccess,subjectAltName,certificatePolicies,crlDistributionPoints,signedCertificateTimestampList",
        "policy=domainValidated",
        "crl=http://ye2.c.lencr.org/96.crl",
        "rawKinds=raw",
        "onDemand=digitalSignature",
        "diagnostics=PKI_DIAG_DEFAULT_ENCODED@tbsCertificate.extensions[0].cA PKI_DIAG_DEFAULT_ENCODED@tbsCertificate.extensions[1].critical PKI_DIAG_DEFAULT_ENCODED@tbsCertificate.extensions[2].critical"
      ]
    },
    {
      "file": "pem-bundle.ts",
      "task": "Read a CA bundle, link each certificate to its issuer, refuse a private key hidden in it",
      "surface": ["decodePem", "encodePem", "parseCertificate", "getExtension", "formatDistinguishedName", "PkiError"],
      "since": "0.1.0",
      "expects": [
        "count=6",
        "links=CN=ISRG Root X1 <- CN=ISRG Root X1; CN=ISRG Root X2 <- CN=ISRG Root X2; CN=E7 <- CN=ISRG Root X2; CN=R12 <- CN=ISRG Root X1; CN=letsencrypt.org <- ?; CN=IETF Test Demo <- CN=IETF Test Demo",
        "privateKey=PKI_PEM_UNEXPECTED_LABEL"
      ]
    },
    {
      "file": "fingerprint.ts",
      "task": "Compute certificate fingerprints synchronously and through Web Crypto, formatted for display and for pinning",
      "surface": ["computeFingerprint", "computeFingerprintAsync", "formatFingerprint"],
      "since": "0.1.0",
      "expects": [
        "sha256=96:BC:EC:06:26:49:76:F3:74:60:77:9A:CF:28:C5:A7:CF:E8:A3:C0:AA:E1:1A:8F:FC:EE:05:C0:BD:DF:08:C6",
        "pin=96bcec06264976f37460779acf28c5a7cfe8a3c0aae11a8ffcee05c0bddf08c6",
        "sameBytes=true"
      ]
    },
    {
      "file": "asn1-and-oids.ts",
      "task": "Build DER with the encoders, read typed fields back, re-encode a certificate byte for byte, and encode, decode, validate and name OIDs",
      "surface": ["encodeSequence", "encodeObjectIdentifier", "encodeInteger", "encodeString", "encodeTime", "decodeAsn1", "readObjectIdentifier", "readInteger", "readString", "readTime", "encodeAsn1Node", "encodeOid", "decodeOid", "isValidOid", "getOidName", "OID_REGISTRY"],
      "since": "0.1.0",
      "expects": [
        "oid=2.5.29.17 subjectAltName",
        "oidStandard=RFC 8017",
        "integer=65537",
        "text=Zoë",
        "time=UTCTime 491231235959Z",
        "reencoded=true",
        "oidRoundTrip=true",
        "oidName=sha256WithRSAEncryption",
        "validOid=true false"
      ]
    },
    {
      "file": "asn1-primitives.ts",
      "task": "Encode and read the BOOLEAN, NULL, BIT STRING and OCTET STRING primitives, reach an arbitrary tag with encodeTlv, and see what DER's SET OF ordering does",
      "surface": ["decodeAsn1", "decodeAsn1Sequence", "encodeBoolean", "encodeNull", "encodeInteger", "encodeOctetString", "encodeBitString", "encodeTlv", "encodeSet", "encodeSetOf", "readBoolean", "readNull", "readSmallInteger", "readOctetString", "readBitString"],
      "since": "0.2.0",
      "expects": [
        "stream=true null 65537 deadbeef",
        "bitString=b0/4",
        "setOf=3109020101020102020103",
        "set=3109020103020101020102",
        "sorted=true",
        "explicit=a003010100"
      ]
    },
    {
      "file": "hostile-input.ts",
      "task": "Meet hostile input with typed errors and caller-tightened limits, never a crash",
      "surface": ["decodeAsn1", "readInteger", "parseCertificate", "PkiError", "PkiEncodingError", "PkiLimitError", "PkiCertificateError", "DEFAULT_PKI_LIMITS"],
      "since": "0.1.0",
      "expects": [
        "deep=PKI_LIMIT_EXCEEDED:maxDepth",
        "truncated=PKI_ASN1_TRUNCATED",
        "halved=PKI_ASN1_TRUNCATED",
        "tightened=PKI_LIMIT_EXCEEDED:maxExtensions",
        "defaultExtensions=256",
        "structural=PKI_X509_STRUCTURE_INVALID",
        "nonMinimalInteger=PKI_ASN1_INTEGER_INVALID@0"
      ]
    }
  ]
}
